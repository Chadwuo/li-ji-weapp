# Li-Ji API Docker 部署参数
# 业务配置请修改 Configuration/*.json，不再放到 .env。

# Docker 镜像地址。默认使用 latest，也可以改为固定版本，例如 chadwuo/li-ji-api:v1.0.0。
LIJI_IMAGE=chadwuo/li-ji-api:latest

# 前端 Docker 镜像。默认使用 latest，也可以改为固定版本。
LIJI_WEB_IMAGE=chadwuo/li-ji-web:latest

# 宿主机暴露端口。访问地址为 http://服务器IP:端口。
LIJI_PORT=8080

# 前端宿主机暴露端口。默认使用 80。
LIJI_WEB_PORT=80

# 容器内数据目录。通常保持默认值。
LIJI_DATA_DIR=/app/data

# ASP.NET Core 运行环境。生产部署保持 Production。
ASPNETCORE_ENVIRONMENT=Production

