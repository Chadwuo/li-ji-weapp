{
  "$schema": "https://gitee.com/dotnetchina/Furion/raw/v4/schemas/v4/furion-schema.json",

  "SpecificationDocumentSettings": {
    "DocumentTitle": "礼记 | Api接口",
    "GroupOpenApiInfos": [
      {
        "Group": "Default",
        "Title": "礼记",
        "Description": "每一份人情都值得礼记。",
        "Version": "6.0.0",
        "TermsOfService": "https://github.com/Chadwuo/li-ji-weapp"
      }
    ]
  },

  "CorsAccessorSettings": {
    "WithExposedHeaders": [
      "access-token",
      "x-access-token",
      "environment"
    ]
  },

  "AllowedHosts": "*",

  "AppSettings": {
    "InjectSpecificationDocument": true // 生产环境是否开启 Swagger
  },

  "SnowId": {
    "WorkerId": 1, // 雪花 ID 机器码，多实例部署时必须全局唯一
    "WorkerIdBitLength": 6, // 机器码位长，默认 6，取值范围 [1, 19]
    "SeqBitLength": 6, // 序列数位长，默认 6，取值范围 [3, 21]
    "WorkerPrefix": "liji_" // 缓存前缀
  }
}
