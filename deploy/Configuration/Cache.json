{
  "$schema": "https://gitee.com/dotnetchina/Furion/raw/v4/schemas/v4/furion-schema.json",

  "Cache": {
    "Prefix": "liji_", // 全局缓存前缀
    "CacheType": "Memory", // 缓存类型：Memory、Redis
    "Redis": {
      "Configuration": "server=redis:6379;password=;db=0;", // Redis 连接字符串，仅 CacheType=Redis 时使用
      "Prefix": "liji_", // Redis key 前缀
      "MaxMessageSize": 1048576, // Redis 最大消息大小，单位：字节
      "AutoDetect": false // 云 Redis 或代理模式通常保持 false
    }
  }
}
